# ── Provider ──────────────────────────────────────────────────────────────────
# Choix du modèle : claude | openai | mistral
PROVIDER=claude

# Nom du modèle (optionnel — sinon le défaut du provider est utilisé)
# Claude  : claude-opus-4-6 | claude-sonnet-4-6 | claude-haiku-4-5-20251001
# OpenAI  : gpt-4o | gpt-4o-mini | gpt-4-turbo
# Mistral : mistral-large-latest | mistral-small-latest | open-mistral-7b
MODEL=claude-sonnet-4-6

# ── API Keys ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
MISTRAL_API_KEY=...

# ── OpenAI-compatible base URL (optionnel) ────────────────────────────────────
# Pour utiliser un proxy ou un modèle local (Ollama, LM Studio, etc.)
# OPENAI_BASE_URL=http://localhost:11434/v1
